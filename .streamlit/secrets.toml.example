# 이 파일을 .streamlit/secrets.toml 로 복사해 값을 채운다(Streamlit Cloud에서는 앱 설정 › Secrets). 커밋 금지.
# 회계담당(운영자)이 아니라 개발자가 처음 배포할 때 한 번 넣는 값들이다.

ANTHROPIC_API_KEY = ""     # 교체는 회계담당이 개발자에게 전달 → 개발자가 여기서 바꾼다
APP_ENV = "dev"            # dev | prod (사용량 집계 구분)

# 민감 설정 암호화 키(Fernet). 만들기: python -c "from core.private import new_key; print(new_key())"
# 바꾸면 기존 settings_private.enc를 풀 수 없으니 바꾸지 않는다.
SETTINGS_KEY = ""

# 최초 접속·비상 복구용 관리자 비밀번호. 앱에서 비밀번호를 정하면 그것이 우선한다.
ADMIN_PASSWORD = ""
# VIEWER_PASSWORD = ""     # 선택: 대시보드 보기·엑셀 다운로드만. 없으면 열람 로그인을 숨긴다.

# 클라우드 모드: GITHUB_TOKEN이 있으면 data/를 GitHub API로 읽고 커밋한다(없으면 로컬 data/).
# GITHUB_TOKEN = ""                      # 저장소 contents 쓰기 권한
# GITHUB_REPO = "owner/church-budget-agent"
# DATA_BRANCH = "main"
# DATA_DIR = ""                          # 로컬 모드에서 data/ 대신 쓸 폴더(환경변수 BUDGET_DATA_DIR도 가능)

# 연락처·계좌는 여기 두지 않는다 — 앱 › 설정에서 입력하면 data/settings_private.enc에 암호화돼 저장된다.
