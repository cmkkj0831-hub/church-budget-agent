# secrets 예시. 값은 절대 커밋하지 않는다(.streamlit/secrets.toml은 .gitignore에 있음).
#  - 로컬: 이 파일을 .streamlit/secrets.toml로 복사해 채운다.
#  - Streamlit Cloud: 앱 › Settings › Secrets 칸에 아래 형식 그대로 붙여 넣는다.
# 개발자가 배포할 때 한 번 넣는 값들이다. 연락처·계좌는 여기 두지 않는다(앱 › 설정에서 입력 → 암호화 저장).

# Claude API 키. console.anthropic.com › API Keys에서 발급(회계담당 계정, 월 사용 한도 설정 권장).
# 교체 절차는 README 'API 키 교체'. 앱 화면에는 설정됨/끝 4자리만 보인다.
ANTHROPIC_API_KEY = ""

# 장부 저장용 GitHub 토큰(fine-grained). github.com › Settings › Developer settings › Fine-grained tokens:
#   Repository access = Only select repositories → 이 저장소 하나, Permissions › Repository › Contents = Read and write
#   (그 밖의 권한은 주지 않는다). 만료일을 정하고 만료 전에 새로 발급해 여기만 바꾼다.
# 비우면 로컬 모드(data/ 폴더)로 동작한다.
GITHUB_TOKEN = ""

# 저장소 "<계정>/church-budget-agent" (비공개 저장소 권장: 장부·교사명단이 들어 있다)
GITHUB_REPO = "<계정>/church-budget-agent"

# 장부를 읽고 커밋할 브랜치. 앱 코드 브랜치(main)와 분리해야 저장할 때마다 앱이 재시작되지 않는다.
DATA_BRANCH = "data"

# data/settings_private.enc(관리자 비밀번호 해시·연락처·계좌) 암호화 키(Fernet).
# 만들기: budget_env/bin/python scripts/gen_settings_key.py
# ⚠️ 잃어버리면 암호화된 설정을 복구할 수 없다. 개인 PC 밖 두 곳에 보관하고, 운영 중에는 바꾸지 않는다.
SETTINGS_KEY = ""

# 최초 접속·비상 복구용 관리자 비밀번호. 회계담당이 앱에서 비밀번호를 정하면 그것이 우선하고,
# 이 값으로 들어오면 '비상 복구'로 보고 새 비밀번호를 정하라고 안내한다. 길고 추측하기 어렵게.
ADMIN_PASSWORD = ""

# 선택: 열람용 비밀번호(대시보드 보기·엑셀 다운로드만). 지우면 열람 로그인이 숨겨진다.
VIEWER_PASSWORD = ""

# dev | prod. 사용량(usage.csv)을 환경별로 나눠 집계한다. Streamlit Cloud 운영은 prod.
APP_ENV = "prod"

# (로컬 전용, 선택) data/ 대신 쓸 폴더. 환경변수 BUDGET_DATA_DIR도 된다.
# DATA_DIR = ""
